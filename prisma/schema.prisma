generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  BRANCHADMIN
  KITCHEN
  CASHIER
  WAITER
  ACCOUNTANT
  CUSTOMER
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SUSPENDED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum TaxType {
  GST
  IGST
  SGST
  CGST
  VAT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

enum MenuAvailability {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

enum KitchenStation {
  MAIN
  GRILL
  BEVERAGE
  DESSERT
  TANDOOR
  BAKERY
}

enum OrderSource {
  QR
  WAITER
  POS
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

// Fulfillment mode, independent of `source` (source = how/who placed it).
// DELIVERY is modeled now so the schema doesn't need reshaping later, but no
// route/UI exposes it yet - no rider/logistics system exists.
enum OrderType {
  DINE_IN
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum KitchenTicketStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  // Whole order cancelled, or every item on this ticket individually
  // cancelled - stays visible on the Kitchen Display (with a clear
  // indicator) until dismissedAt is set, instead of vanishing silently.
  CANCELLED
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  apikey            String?   @unique
  name              String
  role              Role
  status            Boolean   @default(false)
  mobile_verifited  Boolean   @default(false)
  email_verifited   Boolean   @default(false)
  invited           Boolean   @default(false)
  inviteToken       String?
  inviteTokenExpiry DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  waiterOrders     Order[]           @relation("OrderWaiter")
  cashierOrders    Order[]           @relation("OrderCashier")
  orderAuditLogs   OrderAuditLog[]
  stockAdjustments StockAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Currency {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  symbol        String
  country       String
  decimalDigits Int?
  rounding      Int?
  isDefault     Boolean @default(true)

  companies Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id            String  @id @default(uuid())
  name          String
  tenant        String? @unique
  shortname     String?
  gstNumber     String?
  privateapiKey String? @unique
  publicapiKey  String? @unique
  /// Free-form restaurant business type: Restaurant, Cafe, Hotel, Food Court, Cloud Kitchen, Takeaway, Franchise, etc.
  companyType   String

  users          User[]
  branches       Branch[]
  accounts       Account[]
  journals       JournalEntry[]
  taxRates       TaxRate[]
  payments       Payment[]
  vendors        Vendor[]
  customers      Customer[]
  banners        Banner[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  expenses       Expense[]
  purchases      Purchase[]

  storefrontContent StorefrontContent?
  website           Website?
  paymentGateways   PaymentGatewayConfig[]
  branchUpiConfigs  BranchUpiConfig[]

  printers         Printer[]
  printerProfiles  PrinterProfile[]
  receiptTemplates ReceiptTemplate[]
  printerJobs      PrinterJob[]
  printHistory     PrintHistory[]

  subscriptions      Subscription[]
  subscriptionEvents SubscriptionEvent[]

  /// true = no active paid subscription (trial limits apply). Kept in sync by
  /// services/subscription.service.js - the Subscription rows are the source
  /// of truth, this flag is a denormalized convenience.
  trial            Boolean @default(true)
  primaryEmail     String
  secondaryEmail   String?
  primaryPhoneNo   String
  secondaryPhoneNo String?

  logoUrlShort String?
  logoUrlLong  String?

  // Marketplace discovery (CUSTOMER app home page) - a Company is a
  // browsable restaurant brand; these are independent of the operational
  // address fields below, which stay HQ/billing address as before.
  coverImageUrl    String?
  description      String?
  cuisineTags      String[] @default([])
  isPubliclyListed Boolean  @default(true)

  addressLine1 String
  addressLine2 String?
  addressLine3 String?
  city         String
  state        String
  pincode      Int
  license      License?

  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  branch    Int?      @default(1)
  licenses  License[]
  createdAt DateTime  @default(now())
}

model License {
  id          String        @id @default(uuid())
  licenseKey  String        @unique
  planId      String
  companyId   String?       @unique
  company     Company?      @relation(fields: [companyId], references: [id])
  deviceId    String?
  expiresAt   DateTime?
  status      LicenseStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  activatedAt DateTime?
  plan        Plan          @relation(fields: [planId], references: [id])
}

model Banner {
  id          String  @id @default(uuid())
  title       String?
  description String?
  imageUrl    String
  manage      Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  imageId String
  image   Images @relation(fields: [imageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tenant-editable public landing-page content (CUSTOMER app storefront home
// page), managed from qsr-system-admin. Optional 1:1 with Company - a tenant
// with no row here still gets a sensible generic storefront (frontend falls
// back to defaults when fields are empty).
model StorefrontContent {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  heroTag      String?
  heroHeadline String?
  heroSubtext  String?
  heroImageUrl String?

  promiseTitle    String?
  promiseSubtitle String?
  promiseItems    String[] @default([])

  storyTitle   String?
  storyBody    String?
  storyPillars String[] @default([])

  whyChooseTitle String?
  whyChooseItems Json    @default("[]") // [{ icon, title, body }]

  philosophyTitle String?
  philosophyLines String[] @default([])

  testimonialsTitle String?
  testimonials      Json    @default("[]") // [{ quote, author }]

  updatedAt DateTime @updatedAt
}

model Branch {
  id           String  @id @default(uuid())
  name         String
  addressLine1 String
  addressLine2 String?
  addressLine3 String?
  city         String?
  state        String?
  pincode      Int?

  gstNumber        String?
  phone            String?
  latitude         Float?
  longitude        Float?
  openingTime      String? // e.g. "07:00"
  closingTime      String? // e.g. "22:00"
  deliveryRadiusKm Float?
  isOnline         Boolean @default(true)
  acceptOrders     Boolean @default(true)
  kitchenEnabled   Boolean @default(true)
  posEnabled       Boolean @default(true)

  // Standalone QR for the branch's read-only menu card (view prices, order via
  // waiter) - distinct from DiningTable.qrCode, which is per-table and drives
  // the cart/checkout ordering flow.
  menuQrCode String? @unique

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  users            User[]
  diningTables     DiningTable[]
  menuItems        MenuItem[]
  menuItemStocks   MenuItemStock[]
  stockAdjustments StockAdjustment[]
  orders           Order[]
  expenses         Expense[]
  purchases        Purchase[]
  printers         Printer[]
  upiConfig        BranchUpiConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, companyId])
}

model Account {
  id        String         @id @default(uuid())
  name      String
  code      String
  type      AccountType
  companyId String
  company   Company        @relation(fields: [companyId], references: [id])
  parentId  String?
  parent    Account?       @relation("AccountParent", fields: [parentId], references: [id])
  children  Account[]      @relation("AccountParent")
  journals  JournalEntry[]
  expenses  Expense[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model JournalEntry {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  date        DateTime
  description String
  debit       Float
  credit      Float
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  createdAt   DateTime @default(now())
}

model MenuCategory {
  id           String  @id @default(uuid())
  name         String
  description  String?
  displayOrder Int     @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  imageID String? @unique @map("image_id")
  image   Images? @relation(fields: [imageID], references: [id])

  subCategories MenuSubCategory[]
  menuItems     MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_categories")
}

model MenuSubCategory {
  id           String @id @default(uuid())
  name         String
  displayOrder Int    @default(0)

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_sub_categories")
}

model MenuItem {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  isVeg       Boolean @default(true)

  availability    MenuAvailability @default(AVAILABLE)
  price           Float
  prepTimeMinutes Int?
  kitchenStation  KitchenStation   @default(MAIN)
  displayOrder    Int              @default(0)
  isRecommended   Boolean          @default(false)
  isPopular       Boolean          @default(false)
  spicyLevel      Int              @default(0)
  tags            String[]         @default([])

  // Whether this item needs kitchen preparation at all - orders only ever
  // route PREPARED_FRESH items to the Kitchen Display; READY_TO_SERVE items
  // (e.g. bottled drinks, packaged snacks) are handled automatically with
  // no kitchen ticket (see orderService.createKitchenTickets).
  preparationType MenuItemPreparationType @default(PREPARED_FRESH)

  // Optional quantity-based selling: null means a traditional fixed item
  // (ordered as a whole-number count, exactly like before). When set,
  // `price` is interpreted as price-per-unit-of-unitType and orders capture
  // an actual amount in that unit (e.g. 0.5 for "500g" when unitType=KG).
  unitType        MenuItemUnitType?
  customUnitLabel String? // only used when unitType = CUSTOM, e.g. "pack", "box"

  // Only meaningful when unitType is set. true (default) = branch stock is
  // checked/deducted per order, same as before. false = "unlimited" - the
  // item stays available and orders never touch MenuItemStock at all, for
  // products a branch never wants to run out of / doesn't want to track.
  trackInventory Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  subCategoryId String?
  subCategory   MenuSubCategory? @relation(fields: [subCategoryId], references: [id])

  taxRateId String?
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  orderItems       OrderItem[]
  images           Images[]
  stocks           MenuItemStock[]
  stockAdjustments StockAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MenuItemPreparationType {
  PREPARED_FRESH
  READY_TO_SERVE
}

enum MenuItemUnitType {
  PIECE
  GRAM
  KG
  ML
  LITRE
  CUSTOM
}

// Per-branch stock level for quantity-based menu items only - traditional
// fixed items are never tracked here (their availability stays governed by
// the existing manual AVAILABLE/OUT_OF_STOCK/HIDDEN toggle).
model MenuItemStock {
  id String @id @default(uuid())

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  quantityAvailable Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([menuItemId, branchId])
}

// Audit trail for every stock change - manual edits from the Inventory page
// and automatic deductions when an order is placed - so staff can see who
// changed what, when, and why.
model StockAdjustment {
  id String @id @default(uuid())

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  previousQty Float
  newQty      Float
  delta       Float
  reason      String? // e.g. "Manual restock", "Order placed", "Wastage/correction"

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id])
  actorRole String?

  createdAt DateTime @default(now())

  @@index([menuItemId, branchId, createdAt])
}

model DiningTable {
  id       String  @id @default(uuid())
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id])
  tableNo  String
  qrCode   String  @unique
  capacity Int?
  active   Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, tableNo])
}

// A Customer is a global identity (can log in and order across many
// companies via the CUSTOMER app marketplace) - companyId is now only a
// legacy/first-touch reference, not an ownership scope. Each Order still
// carries its own companyId independently, so per-company staff routes are
// unaffected by this.
model Customer {
  id           String  @id @default(uuid())
  name         String
  email        String? @unique
  phone        String?
  passwordHash String?
  otpVerified  Boolean @default(false)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id        String     @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  gstin     String     @unique
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Order {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  tableId String?
  table   DiningTable? @relation(fields: [tableId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  waiterId String?
  waiter   User?   @relation("OrderWaiter", fields: [waiterId], references: [id])

  cashierId String?
  cashier   User?   @relation("OrderCashier", fields: [cashierId], references: [id])

  status    OrderStatus @default(PLACED)
  source    OrderSource @default(QR)
  orderType OrderType   @default(DINE_IN)
  notes     String?

  kotNumber String?

  subtotal    Float
  taxAmount   Float @default(0)
  discount    Float @default(0)
  totalAmount Float

  orderItems     OrderItem[]
  payments       Payment[]
  kitchenTickets KitchenTicket[]
  auditLogs      OrderAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderAuditLog {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  /// "ORDER" for Order.status changes, "KITCHEN_TICKET" for KitchenTicket.status changes
  entityType String
  ticketId   String?

  fromStatus String?
  toStatus   String

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  role   String?
  note   String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  price    Float
  // Float, not Int - quantity-based items (see MenuItem.unitType) can be
  // ordered in fractional amounts, e.g. 0.5 for "500g" when sold by KG.
  quantity Float
  remarks  String?
  status   OrderItemStatus @default(PENDING)
  total    Float

  taxRateId String?
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  kitchenTicketId String?
  kitchenTicket   KitchenTicket? @relation(fields: [kitchenTicketId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KitchenTicket {
  id          String              @id @default(uuid())
  orderId     String
  order       Order               @relation(fields: [orderId], references: [id])
  token       String
  station     KitchenStation
  status      KitchenTicketStatus @default(PENDING)
  // Set when kitchen staff explicitly acknowledges a CANCELLED ticket - only
  // then can it be removed from the active Kitchen Display list.
  dismissedAt DateTime?

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  amount           Float
  method           PaymentMethod
  gatewayPaymentId String?       @unique
  rawResponse      String?
  referenceNo      String?
  date             DateTime      @default(now())
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaxRate {
  id        String  @id @default(uuid())
  name      String
  rate      Float
  type      TaxType
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  menuItems  MenuItem[]
  orderItems OrderItem[]
  expenses   Expense[]
  purchases  Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  date   DateTime
  amount Float

  taxRateId   String?
  taxRate     TaxRate? @relation(fields: [taxRateId], references: [id])
  taxAmount   Float    @default(0)
  totalAmount Float

  note String?

  expenseImages ExpenseImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  date   DateTime
  amount Float

  taxRateId   String?
  taxRate     TaxRate? @relation(fields: [taxRateId], references: [id])
  taxAmount   Float    @default(0)
  totalAmount Float

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpenseImage {
  id String @id @default(uuid())

  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id])

  imageId String
  image   Images @relation(fields: [imageId], references: [id])

  imageUrl String

  createdAt DateTime @default(now())
}

model Images {
  id       String  @id @default(uuid())
  url      String
  key      String?
  docid    Int?
  filename String?
  mimetype String?
  size     Int?

  expenseImages ExpenseImage[]

  /// Image may belong to ONE menu category
  category MenuCategory?

  banners Banner[]

  /// Still supports menu item gallery images (optional)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])

  createdAt DateTime @default(now())

  @@map("images")
}

// ---------------------------------------------------------------------------
// Website Builder - isolated drag-and-drop (Tailwind + GrapesJS) alternative
// to StorefrontContent above. A Company that never touches the builder has
// no Website row here, and the customer app keeps rendering StorefrontContent
// (or its own generic defaults) exactly as before.
// ---------------------------------------------------------------------------

model Website {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  name         String        @default("My Website")
  status       WebsiteStatus @default(DRAFT)
  customDomain String?       @unique

  /// Unguessable token letting the builder preview draft (unpublished) pages
  /// via the public tenant subdomain without exposing them to the world -
  /// see GET /api/public/tenant/:slug's `?preview=` handling.
  previewToken String @unique @default(uuid())

  themeId String?
  theme   Theme?  @relation(fields: [themeId], references: [id])

  pages  Page[]
  assets Asset[]

  navigation       Navigation?
  globalComponents GlobalComponent[]

  deployments Deployment[]
  domains     Domain[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DeploymentStatus {
  QUEUED
  GENERATING
  BUILDING
  DEPLOYING
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

// One row per publish attempt. `version` is a per-website incrementing counter -
// the static generator uploads to sites/{websiteId}/versions/{version}/ in DO
// Spaces and then copies that version's objects into sites/{websiteId}/live/
// (the path actually served), so rollback is just re-copying an older version's
// objects back into live/ rather than regenerating anything.
model Deployment {
  id        String  @id @default(uuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id])

  version     Int
  environment String @default("production")

  previewUrl    String?
  productionUrl String?

  status       DeploymentStatus @default(QUEUED)
  errorMessage String?

  createdBy   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([websiteId, version])
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DomainSslStatus {
  NONE
  PENDING
  ACTIVE
  FAILED
}

model Domain {
  id        String  @id @default(uuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id])

  hostname  String  @unique
  isPrimary Boolean @default(false)

  verificationStatus DomainVerificationStatus @default(PENDING)
  /// Shown to the user as the TXT record value to add at their DNS provider -
  /// POST /domains/:id/verify does a real dns.resolveTxt lookup against this.
  verificationToken  String                   @default(uuid())

  sslStatus DomainSslStatus @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Site-wide menu, 1:1 with Website. Page-linked items store only a `pageId` -
// label/href are derived live from the current Page at render/edit time, so
// renaming or deleting a page never requires an explicit "re-sync" step.
model Navigation {
  id        String  @id @default(uuid())
  websiteId String  @unique
  website   Website @relation(fields: [websiteId], references: [id])

  style       String  @default("horizontal") // horizontal | vertical | mega
  sticky      Boolean @default(true)
  transparent Boolean @default(false)
  showSearch  Boolean @default(false)
  showSocial  Boolean @default(false)

  /// { label, link } | null
  ctaButton Json?

  /// Tree, up to 3 levels: [{ id, label?, linkType: 'page'|'external'|'anchor', pageId?, url?, children: [...] }]
  items Json @default("[]")

  updatedAt DateTime @updatedAt
}

enum GlobalComponentKey {
  HEADER
  FOOTER
  NEWSLETTER
  CONTACT_FORM
  ANNOUNCEMENT_BAR
  COOKIE_BANNER
}

// A block instance shared across every page that references it via a
// { type: "GlobalComponentRef", key } entry in Page.draftBlocks/publishedBlocks -
// editing it once (through any page) updates everywhere it's referenced.
model GlobalComponent {
  id        String  @id @default(uuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id])

  key       GlobalComponentKey
  blockType String
  props     Json

  updatedAt DateTime @updatedAt

  @@unique([websiteId, key])
}

model Page {
  id        String  @id @default(uuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id])

  slug   String
  title  String
  isHome Boolean @default(false)
  /// Manual ordering for the Pages panel/nav - createdAt order isn't user-controllable
  order  Int     @default(0)

  /// Working copy, edited live in the builder: { blocks: [{ type, props }] }.
  /// May contain { type: "GlobalComponentRef", key } entries alongside normal
  /// { type, props } blocks - resolved against GlobalComponent at render/edit time.
  draftBlocks Json

  /// Last published snapshot - null until this page is published at least once
  publishedBlocks Json?

  seoTitle       String?
  seoDescription String?

  status PageStatus @default(DRAFT)

  versions PageVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteId, slug])
}

model PageVersion {
  id     String @id @default(uuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id])

  blocks Json
  /// e.g. "Autosave", "Published"
  label  String?

  createdAt DateTime @default(now())
}

model Template {
  id           String  @id @default(uuid())
  name         String
  category     String
  thumbnailUrl String?

  /// Starter layout: { blocks: [{ type, props }] }
  blocks Json

  isSystem Boolean @default(true)

  createdAt DateTime @default(now())
}

model Asset {
  id        String  @id @default(uuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id])

  url      String
  key      String?
  filename String
  mimetype String?
  size     Int?

  createdAt DateTime @default(now())
}

model Theme {
  id     String @id @default(uuid())
  name   String
  /// { primary, secondary, accent, background, text }
  colors Json

  fontHeading String?
  fontBody    String?

  isSystem Boolean @default(true)

  websites Website[]

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Payment Gateway Settings - per-merchant, server-side configured (not env
// vars), so a company can store more than one gateway's credentials even
// though only one is ever `isActive` at checkout. Real integration lives in
// src/services/paymentGateways/ (routes/paymentGateways.js for merchant CRUD,
// routes/publicPayments.js for the actual checkout-time initiate/verify).
// ---------------------------------------------------------------------------

enum PaymentGatewayProvider {
  RAZORPAY
  CASHFREE
  WORLDLINE
  /// POS counter UPI QR via @bucksbox/capacitor-sdk (keyId = clientId,
  /// keySecret = AES key). Never `isActive` - it isn't an online-checkout
  /// gateway, so it must not displace the storefront's active one.
  BUCKSBOX
}

/// BucksBox UPI QR credentials for one branch (outlet), overriding the
/// company-wide PaymentGatewayConfig(provider BUCKSBOX) default - lets each
/// outlet collect into its own BucksBox merchant/VPA. POS only.
model BranchUpiConfig {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  branchId  String  @unique
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// BucksBox Client ID (User.apiKey) and AES key (User.SaltAESKey)
  clientId String
  key      String
  /// "test" (staging) | "live" (production)
  mode     String @default("test")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model PaymentGatewayConfig {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  provider PaymentGatewayProvider @default(RAZORPAY)

  keyId         String
  /// Plain field, same convention as Company.privateapiKey/publicapiKey - no
  /// encryption-at-rest infra exists in this codebase to hook into.
  keySecret     String
  webhookSecret String?

  /// "test" | "live"
  mode     String  @default("test")
  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider])
}

// ---------------------------------------------------------------------------
// POS Terminal Printing - printer registry + receipt template engine.
// A Printer's connectionConfig shape depends on connectionType:
//   NETWORK   { ip, port }            (default port 9100 - raw ESC/POS over TCP)
//   USB       { vendorId, productId }
//   BLUETOOTH { address }             (MAC on Android, UUID on iOS/Web Bluetooth)
//   WEBUSB / WEBSERIAL / SYSTEM: browser owns the handle, nothing persisted
//   server-side beyond the type - these print client-side, never via the
//   backend's own TCP driver.
// PrinterJob is the offline/retry queue (backed by BullMQ, see
// queues/print.queue.js + workers/printWorker.js, mirroring the existing
// publish queue/worker pattern); PrintHistory is the permanent audit log a
// completed/failed job gets copied into, kept even after old jobs age out.
// ---------------------------------------------------------------------------

enum PrinterConnectionType {
  NETWORK
  USB
  BLUETOOTH
  WEBUSB
  WEBSERIAL
  SYSTEM
}

enum PrintFormat {
  ESC_POS
  HTML
  PDF
  PNG
}

enum ReceiptTemplateType {
  RECEIPT
  KOT
  INVOICE
}

enum PrinterJobStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

model PrinterProfile {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name         String
  /// 58 or 80 - standard thermal roll widths in mm.
  paperWidthMm Int    @default(80)
  charsPerLine Int    @default(48)
  /// { hasCutter, hasDrawer, hasBarcode, hasQr, dpi }
  capabilities Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  printers Printer[]

  @@unique([companyId, name])
}

model Printer {
  id               String          @id @default(uuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id])
  printerProfileId String?
  printerProfile   PrinterProfile? @relation(fields: [printerProfileId], references: [id])

  name             String
  connectionType   PrinterConnectionType
  /// Shape depends on connectionType - see section comment above.
  connectionConfig Json                  @default("{}")
  isDefault        Boolean               @default(false)
  isActive         Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  printerJobs  PrinterJob[]
  printHistory PrintHistory[]

  @@unique([companyId, name])
}

model ReceiptTemplate {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name       String
  type       ReceiptTemplateType @default(RECEIPT)
  /// The designer's block tree - page settings + blocks[] (Logo, Items
  /// Table, QR, Barcode, etc.) with position/style/conditional-visibility
  /// per block. Same "render engine reads this, not code" contract as
  /// StorefrontContent's block-based pages.
  layoutJson Json
  isDefault  Boolean             @default(false)
  isActive   Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  printerJobs  PrinterJob[]
  printHistory PrintHistory[]

  @@unique([companyId, name])
}

model PrinterJob {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  printerId         String
  printer           Printer          @relation(fields: [printerId], references: [id])
  receiptTemplateId String?
  receiptTemplate   ReceiptTemplate? @relation(fields: [receiptTemplateId], references: [id])
  orderId           String?

  format  PrintFormat
  /// Resolved receipt data snapshot at enqueue time, so a retry hours later
  /// reprints exactly what was originally intended even if the order's own
  /// state has since changed (e.g. a refund).
  payload Json

  status    PrinterJobStatus @default(QUEUED)
  attempts  Int              @default(0)
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Subscriptions - QSR is a consumer of the central Payment Subscription
// product (server-to-server, see plugins/subscription.js). Plans and the
// Worldline mandate live there; QSR keeps its own record of each purchase
// attempt so access can be decided locally without calling out on every
// request. One Subscription row = one checkout attempt (the central order).
// Only a server-side verifyMandate result of "0300" ever moves a row to
// ACTIVE - never anything reported by the browser.
// ---------------------------------------------------------------------------

enum CompanySubscriptionStatus {
  PENDING    // checkout started, mandate not yet confirmed
  ACTIVE     // mandate confirmed, inside the paid period
  FAILED     // mandate rejected (0399) or verification failed permanently
  EXPIRED    // paid period ended and the mandate could not be re-confirmed
  CANCELLED  // ended by an admin
  SUPERSEDED // replaced by a newer checkout attempt or a newer active plan
}

model Subscription {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Central product / plan ids (SUBS_PRODUCT_ID and the chosen plan).
  productId String
  planId    String

  /// Snapshot of the central plan at purchase time - name/price can change
  /// centrally later; this is what the customer actually signed up for.
  planName     String
  planInterval String
  price        Float
  currency     String @default("INR")
  planSnapshot Json?

  status CompanySubscriptionStatus @default(PENDING)

  /// Central Order.order_id (the Worldline txn_id) - the key for verifyMandate.
  centralOrderId String  @unique
  mandateId      String?
  /// Last raw Worldline mandate status code seen ("0300" active, "0398"
  /// pending, "0399" failed).
  mandateStatus  String?

  activatedAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  lastVerifiedAt     DateTime?
  endedAt            DateTime?
  /// Short, safe reason for FAILED / EXPIRED / SUPERSEDED / CANCELLED.
  statusReason       String?

  createdById String?

  events SubscriptionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([status, currentPeriodEnd])
}

/// Audit trail of every subscription state change (who/what triggered it).
model SubscriptionEvent {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  /// e.g. INITIATED, ACTIVATED, VERIFY_PENDING, FAILED, RENEWED, EXPIRED,
  /// SUPERSEDED, GRACE
  type       String
  fromStatus String?
  toStatus   String?
  actorId    String?
  note       String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([subscriptionId])
}

model PrintHistory {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  printerId         String?
  printer           Printer?         @relation(fields: [printerId], references: [id])
  receiptTemplateId String?
  receiptTemplate   ReceiptTemplate? @relation(fields: [receiptTemplateId], references: [id])
  orderId           String?

  format       PrintFormat
  status       PrinterJobStatus
  errorMessage String?

  createdAt DateTime @default(now())
}
