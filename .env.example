# Copy to .env.development (local) / set in your host (production).
# Placeholders only - never commit real values.

NODE_ENV=development
PORT=8081
HOST=0.0.0.0
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/qsr
JWT_SECRET=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

allowedOrigins=["http://localhost:3000"]

# --- Central Payment Subscription product (server-to-server) ---------------
# Base URL of the subscription backend (use https in production).
SUBSCRIPTION_BASE_URL=http://localhost:3002
# API key of an *admin* user of the subscription tenant (sent as x-api-key;
# its plan/initiate/verifyMandate routes require the admin role).
SUBSCRIPTION_APIKEY=
# The QSR product's id in the subscription system - only its plans are offered.
SUBS_PRODUCT_ID=

# Optional: days of continued access when a renewal can't be confirmed
# because the subscription service is unreachable (default 3).
SUBSCRIPTION_GRACE_DAYS=3
# Optional: override free-trial limits (null = unlimited). Defaults:
# {"BRANCHES":1,"STAFF_USERS":5,"MENU_ITEMS":30,"TABLES":10,"ORDERS":50}
SUBSCRIPTION_TRIAL_LIMITS=
# Optional: limits for specific paid plans, keyed by central plan id.
# Paid plans are unlimited unless listed here.
# {"<central-plan-id>":{"BRANCHES":3,"STAFF_USERS":20}}
SUBSCRIPTION_PLAN_LIMITS=
