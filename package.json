{
  "name": "accounting-app-inventory",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "seed": "node prisma/seed.js",
    "seedcurrency": "node prisma/seedCurrency.js",
    "seedration": "node prisma/seedRation.js",
    "seedbuilder": "node prisma/seedBuilder.js",
    "build:static-css": "tailwindcss -i src/assets/static-site-input.css -o src/generated/static-site.css --config tailwind.config.static.js --minify",
    "studio": "npx prisma studio",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev && prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.937.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/view": "^11.1.1",
    "@prisma/client": "^6.13.0",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.65.1",
    "bwip-js": "^4.11.2",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "fastify": "^5.5.0",
    "html-minifier-terser": "^7.2.0",
    "pino-pretty": "^9.0.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.13.0",
    "tailwindcss": "^3.4.19"
  }
}
